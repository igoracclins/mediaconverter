{
  "name": "mediaconverter",
  "productName": "Media Converter",
  "version": "0.2.4",
  "description": "Local-first, cross-platform desktop application for batch media conversion (audio, video and images).",
  "author": "Igor <igoracciolylima@gmail.com>",
  "license": "MIT",
  "private": true,
  "main": "./out/main/index.js",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "electron-vite build",
    "typecheck": "vue-tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "ffmpeg:prepare": "node scripts/ffmpeg/prepare.mjs",
    "ffmpeg:verify": "node scripts/ffmpeg/verify.mjs",
    "ffmpeg:info": "node scripts/ffmpeg/info.mjs",
    "deps:check": "node scripts/check-deps.mjs",
    "licenses:check": "node scripts/licenses/audit.mjs",
    "pack:dir": "npm run build && electron-builder --dir",
    "pack:mac": "npm run build && electron-builder --dir --mac --arm64",
    "pack:win": "npm run build && electron-builder --dir --win --x64",
    "dist": "npm run build && electron-builder",
    "dist:mac": "npm run build && electron-builder --mac --arm64",
    "dist:win": "npm run build && electron-builder --win --x64",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "sharp": "0.35.4"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.13.3",
    "@vitejs/plugin-vue": "6.0.8",
    "@vue/test-utils": "2.5.0",
    "electron": "44.3.0",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-vue": "10.10.0",
    "globals": "16.5.0",
    "jsdom": "27.4.0",
    "prettier": "3.9.6",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.68.0",
    "vite": "7.3.6",
    "vitest": "4.1.11",
    "vue": "3.5.42",
    "vue-eslint-parser": "10.4.1",
    "vue-tsc": "3.3.11"
  },
  "optionalDependencies": {
    "@img/sharp-libvips-win32-x64": "1.3.3",
    "@img/sharp-win32-x64": "0.35.4"
  }
}
